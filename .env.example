NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fhdod_ouvidoria
DB_SSL=false
# Em Aiven, informe o certificado CA codificado em Base64 e mantenha a validação ativa.
DB_SSL_CA_BASE64=
DB_SSL_CA_FILE=
JWT_SECRET=gere_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=gere_outro_segredo_longo_e_aleatorio
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SECTOR_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_MODE=mock
# Use live somente após configurar e autorizar um provedor.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANGUAGE=pt_BR
INVITATION_EXPIRATION_HOURS=72
MAX_FEEDBACK_LENGTH=500
TVWALL_ACCESS_TOKEN=
TVWALL_MIN_RESPONSES=5
SWAGGER_ENABLED=true
